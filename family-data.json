    "marvin_howard_yates_228": {
        "name": "Marvin Howard Yates",
        "dob": "5/20/1937",
        "pob": "Low Wassie, MO",
        "dod": "9/19/2009",
        "pod": "Birch Tree, MO",
        "cemetery": "Oak Grove Cemetery",
        "cemeteryLocation": "Birch Tree, MO",
        "fatherId": "marvin_yates_226",
        "motherId": "dolly_e_clemons_265",
